# Copy this file to clawlite_config.env and fill in your provider.
# The real config file is ignored by git.

CLAWLITE_BASE_URL=https://your-provider.example/v1
CLAWLITE_API_KEY=replace-with-your-key
CLAWLITE_MODEL=replace-with-your-model
CLAWLITE_TEMPERATURE=0.7
CLAWLITE_MAX_TOKENS=4096
CLAWLITE_TIMEOUT_MS=60000
