# Copy this file to clawlite_config.env and fill in your key.
# clawlite_config.env is ignored by git. Environment variables override this file.

CLAWLITE_BASE_URL=https://api.mimo-v2.com/v1
CLAWLITE_API_KEY=replace-with-your-key
CLAWLITE_MODEL=mimo-v2.5-pro
CLAWLITE_TEMPERATURE=0.7
CLAWLITE_MAX_TOKENS=4096
CLAWLITE_TIMEOUT_MS=60000
CLAWLITE_MAX_TOKENS_FIELD=max_completion_tokens
CLAWLITE_SEND_API_KEY_HEADER=true

# Long-context data-structure settings
CLAWLITE_CONTEXT_TOKEN_BUDGET=12000
CLAWLITE_CHUNK_TOKENS=220
CLAWLITE_OVERLAP_TOKENS=50
CLAWLITE_SUMMARY_GROUP_SIZE=6
CLAWLITE_KEEP_RECENT_TURNS=4
CLAWLITE_FILE_CACHE_CAPACITY=32
CLAWLITE_WORKSPACE_DIR=.
CLAWLITE_DATA_DIR=.clawlite
